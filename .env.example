DATABASE_URL="postgresql://english_coach:english_coach@127.0.0.1:5432/english_coach?schema=public"
# Used by integration tests (a separate database, never your dev data).
TEST_DATABASE_URL="postgresql://english_coach:english_coach@127.0.0.1:5432/english_coach_test?schema=public"

# Which AI provider to use for the Writing Coach / AI features: "anthropic" (default) or "gemini".
AI_PROVIDER="anthropic"

# Anthropic Claude API key — used when AI_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Google Gemini API key — used when AI_PROVIDER=gemini.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
