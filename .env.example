# Copy to .env for local development. Never commit .env or put real values in this file.

# --- Database ---------------------------------------------------------------------------
# Use 127.0.0.1, not localhost (Prisma's pg adapter fails on localhost on some Windows setups).
DATABASE_URL="postgresql://english_coach:english_coach@127.0.0.1:5432/english_coach?schema=public"
# Integration tests use a separate database; they wipe it. Never point this at real data.
TEST_DATABASE_URL="postgresql://english_coach:english_coach@127.0.0.1:5432/english_coach_test?schema=public"

# --- Secrets (required in production; generate each with the command below) --------------
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Signs the anonymous-session cookie.
SESSION_SECRET=""
# Salt for hashing client IPs in rate limiting.
IP_HASH_SALT=""
# Bearer secret protecting the cleanup cron endpoint (/api/cron/cleanup).
CRON_SECRET=""

# --- Site -------------------------------------------------------------------------------
# Public origin for canonical/OG URLs and the sitemap. Optional on Vercel (falls back to
# VERCEL_PROJECT_PRODUCTION_URL); set it when using a custom domain.
NEXT_PUBLIC_SITE_URL=""

# --- AI (local development only; ignored in production) ---------------------------------
# In production every visitor brings their own key on /settings and the server never reads
# these. Locally they are a convenience so you don't have to paste a key into the browser.
# "anthropic" (default) or "gemini".
AI_PROVIDER="gemini"
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
