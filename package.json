{
  "name": "grifando",
  "version": "0.1.0",
  "private": true,
  "description": "AI English writing coach for Brazilian developers: your mistakes become your practice.",
  "homepage": "https://grifando.vercel.app",
  "repository": { "type": "git", "url": "https://github.com/levyrodrigues23/grifando" },
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:test:prepare": "tsx scripts/prepare-test-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@base-ui/react": "^1.8.0",
    "@google/genai": "3.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "0.3.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.45.0",
    "next": "16.4.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
